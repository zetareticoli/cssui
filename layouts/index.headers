/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; frame-ancestors 'self' https://jamstackthemes.dev https://app.netlify.com; frame-src 'self' https://app.netlify.com; manifest-src 'self'; connect-src 'self' https://plausible.io https://app.netlify.com https://*.netlify.app; font-src 'self' https://www.cssui.dev; img-src 'self' https://www.cssui.dev https://app.netlify.com data:; script-src 'self' https://www.cssui.dev https://plausible.io https://app.netlify.com https://netlify-cdp-loader.netlify.app; style-src 'self' https://www.cssui.dev 'unsafe-inline'
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin
  Feature-Policy: geolocation 'self'
  Cache-Control: public, max-age=31536000